+#ifdef NSH_EXTERNAL_ENGINE
+    nsh_android_leave_vm();
+    return napi_ok;
+#endif
     auto jsr = JSR::env_to_jsr_cache.Get(env);
     if (jsr) jsr->unlock();
 
