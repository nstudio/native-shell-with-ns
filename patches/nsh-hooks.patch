+static ENGINE_RUNNER: std::sync::Mutex<Option<Sender<Message>>> = std::sync::Mutex::new(None);
+
+/// Runs `run` on the thread of the engine started last, between its turns.
+/// False when no engine is running.
+pub fn run_on_engine(run: Box<dyn FnOnce() + Send>) -> bool {
+    match &*ENGINE_RUNNER.lock().unwrap_or_else(|e| e.into_inner()) {
+        Some(tx) => tx.send(Message::Run(run)).is_ok(),
+        None => false,
+    }
+}
