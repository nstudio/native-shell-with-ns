 };
 
+/// Called with each new VM's `JSContext` (as a raw pointer) on the engine
+/// thread, after the standard modules are installed and before hardening
+/// freezes the globals.
+pub type ContextHook = fn(*mut std::ffi::c_void);
+
+static CONTEXT_HOOK: std::sync::OnceLock<ContextHook> = std::sync::OnceLock::new();
+
+/// Sets the hook every VM created afterwards runs.
+pub fn set_context_hook(hook: ContextHook) {
+    let _ = CONTEXT_HOOK.set(hook);
+}
+
+pub(crate) fn has_context_hook() -> bool {
+    CONTEXT_HOOK.get().is_some()
+}
+
+pub(crate) fn run_context_hook(context: *mut std::ffi::c_void) {
+    if let Some(hook) = CONTEXT_HOOK.get() {
+        hook(context);
+    }
+}
